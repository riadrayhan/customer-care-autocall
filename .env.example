PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Change this to a strong random string in production
JWT_SECRET=change_this_secret_in_production

# Initial admin (only used on FIRST run when data/admins.json is missing/empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# STUN Servers (Google's free STUN - fine for ~80% of networks)
STUN_URL_1=stun:stun.l.google.com:19302
STUN_URL_2=stun:stun1.l.google.com:19302

# Optional TURN server (RECOMMENDED for production — free TURN at https://metered.ca/tools/openrelay/)
# TURN_URL=turn:openrelay.metered.ca:80
# TURN_USERNAME=your_username
# TURN_CREDENTIAL=your_password

# Per-admin call rate limit
CALL_RATE_LIMIT=30
CALL_RATE_WINDOW=60000

# ─── FCM push wake-up (optional, but required for "ring while app killed") ───
# Either inline JSON of the Firebase service-account file…
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# … or place the JSON file at data/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=./data/firebase-service-account.json

# ─── DB file paths (override only if needed) ───
# USERS_DB_FILE=./data/users.json
# ADMINS_DB_FILE=./data/admins.json

